---
import { site, steps, t } from "../data/site";
import T from "./T.astro";
---

<section id="buy" class="ds-section" aria-labelledby="buy-title">
  <div class="ds-wrap">
    <div class="ds-section__head">
      <h2 id="buy-title" class="ds-section__title"><T zh={t.buyTitle.zh} en={t.buyTitle.en} /></h2>
    </div>

    <ol class="ds-steps">
      {
        steps.map((step, index) => (
          <li class="ds-step">
            <span class="ds-step__num" aria-hidden="true">{index + 1}</span>
            <span class="ds-step__text">
              <T zh={step.zh} en={step.en} />
            </span>
          </li>
        ))
      }
    </ol>

    <div class="ds-contact">
      <div class="ds-contact__list">
        <div class="ds-field">
          <span class="ds-field__label"><T zh={t.emailLabel.zh} en={t.emailLabel.en} /></span>
          <span class="ds-field__row">
            <a class="ds-field__value ds-field__value--link" href={`mailto:${site.email}`}>{site.email}</a>
          </span>
        </div>

        <div class="ds-field">
          <span class="ds-field__label"><T zh={t.wechatLabel.zh} en={t.wechatLabel.en} /></span>
          <span class="ds-field__row">
            <span class="ds-field__value">{site.wechatId}</span>
            <button id="wechat-copy" class="ds-copy" type="button" data-copy={site.wechatId}>
              <T zh={t.copy.zh} en={t.copy.en} />
            </button>
          </span>
        </div>
      </div>

      <img class="ds-qr" src={site.wechatQr} width="643" height="651" alt="WeChat QR code / 微信二维码" loading="lazy" />
    </div>

    <p class="ds-note"><T zh={t.note.zh} en={t.note.en} /></p>
  </div>
</section>
